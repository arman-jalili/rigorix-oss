{
	"compilerOptions": {
		"types": [
			"bun-types"
		],
		"strict": true,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"**/*.ts",
		"../pi-env.d.ts"
	]
}
